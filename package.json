{
  "name": "@cycle/lit-dom",
  "version": "1.0.0",
  "description": "The lit-html DOM Driver for Cycle.js, based on lit-html and RxJS",
  "license": "MIT",
  "packageManager": "yarn@4.9.2",
  "contributors": [
    {
      "name": "Fabiano Taioli",
      "email": "ftaioli@gmail.com"
    }
  ],
  "keywords": [
    "reactive",
    "framework",
    "rxjs",
    "rx",
    "unidirectional",
    "mvi",
    "virtual-dom",
    "lit-html"
  ],
  "main": "lib/cjs/index.js",
  "module": "lib/es6/index.js",
  "typings": "lib/cjs/index.d.ts",
  "types": "lib/cjs/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "yarn build-cjs && yarn build-es6",
    "build-cjs": "tsc --module commonjs --outDir ./lib/cjs",
    "build-es6": "tsc --module es6 --outDir ./lib/es6",
    "lint": "eslint src/**/*.ts --fix",
    "example": "./run-example.sh",
    "example:build": "yarn build && cd example && yarn install",
    "example:dev": "cd example && yarn dev",
    "example2": "./run-example2.sh",
    "example2:build": "yarn build && cd example2 && yarn install",
    "example2:dev": "cd example2 && yarn dev"
  },
  "dependencies": {
    "lit-html": "^3.1.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@cycle/isolate": "^5.0.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.0.0",
    "@types/sinon": "^17.0.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "deepmerge": "~4.0.0",
    "es6-map": "^0.1.5",
    "es6-set": "^0.1.5",
    "eslint": "^8.0.0",
    "mocha": "^10.0.0",
    "mutation-observer": "1.0.3",
    "simulant": "^0.2.2",
    "sinon": "^17.0.0",
    "symbol-observable": "^4.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
