{
  "name": "@cycle/lit-dom",
  "version": "1.0.0",
  "description": "The lit-html DOM Driver for Cycle.js, based on lit-html and RxJS",
  "license": "MIT",
  "homepage": "https://cycle.js.org",
  "bugs": "https://github.com/cyclejs/cyclejs/issues",
  "repository": "https://github.com/cyclejs/cyclejs/tree/master/lit-dom",
  "contributors": [
    {
      "name": "Claude AI",
      "email": "noreply@anthropic.com"
    }
  ],
  "keywords": [
    "reactive",
    "framework",
    "rxjs",
    "rx",
    "unidirectional",
    "mvi",
    "virtual-dom",
    "lit-html",
    "performance"
  ],
  "main": "lib/cjs/index.js",
  "module": "lib/es6/index.js",
  "typings": "lib/cjs/index.d.ts",
  "types": "lib/cjs/index.d.ts",
  "scripts": {
    "build": "pnpm run build-cjs && pnpm run build-es6",
    "build-cjs": "tsc --module commonjs --outDir ./lib/cjs",
    "build-es6": "tsc --module es6 --outDir ./lib/es6",
    "lint": "eslint src/**/*.ts --fix",
    "docs": "cd .. && node .scripts/make-api-docs.js lit-dom",
    "changelog": "cd .. && node .scripts/update-changelogs.js lit-dom",
    "test-node": "mocha test/node/*.ts --require ts-node/register --exit",
    "test-browser": "karma start",
    "test": "pnpm run test-node && pnpm run test-browser",
    "test-ci": "CI=true ../.scripts/retry.sh pnpm test",
    "test-watch": "WATCH=true pnpm test",
    "test-live": "LIVE=true karma start --watch",
    "example": "./run-example.sh",
    "example:build": "pnpm run build && cd example && pnpm install",
    "example:dev": "cd example && pnpm run dev",
    "example2": "./run-example2.sh",
    "example2:build": "pnpm run build && cd example2 && pnpm install",
    "example2:dev": "cd example2 && pnpm run dev",
    "prepublishOnly": "pnpm run build && pnpm test"
  },
  "dependencies": {
    "lit-html": "^3.1.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@cycle/isolate": "^5.0.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.0.0",
    "@types/sinon": "^17.0.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "deepmerge": "~4.0.0",
    "es6-map": "^0.1.5",
    "es6-set": "^0.1.5",
    "eslint": "^8.0.0",
    "karma": "^6.4.0",
    "karma-browserstack-launcher": "^1.6.0",
    "karma-chrome-launcher": "^3.2.0",
    "karma-firefox-launcher": "^2.1.0",
    "karma-mocha": "^2.0.1",
    "karma-typescript": "^5.5.0",
    "mocha": "^10.0.0",
    "mutation-observer": "1.0.3",
    "simulant": "^0.2.2",
    "sinon": "^17.0.0",
    "symbol-observable": "^4.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "funding": {
    "type": "opencollective",
    "url": "https://opencollective.com/cyclejs"
  },
  "publishConfig": {
    "access": "public"
  }
}
